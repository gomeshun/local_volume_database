{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:data": "node scripts/generate-datasets.mjs && node scripts/generate-simbad.mjs && node scripts/generate-kinematics.mjs",
    "refresh:vizier": "node scripts/generate-datasets.mjs --refresh-vizier",
    "refresh:simbad": "node scripts/generate-simbad.mjs --refresh",
    "refresh:simbad:force": "node scripts/generate-simbad.mjs --refresh --force",
    "refresh:simbad:retry-bad": "node scripts/generate-simbad.mjs --refresh --retry-bad",
    "prepare:data:force": "npm run refresh:simbad:force && npm run prepare:data",
    "prepare:data:retry-bad": "npm run refresh:simbad:retry-bad && npm run prepare:data",
    "predev": "npm run prepare:data",
    "dev": "next dev",
    "prebuild": "npm run prepare:data",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:data": "node scripts/test-generated-data.mjs",
    "check:artifacts": "node scripts/check-artifact-budgets.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.23",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  }
}
